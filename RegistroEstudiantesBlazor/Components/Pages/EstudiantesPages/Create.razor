@page "/Estudiantes/Create"
@rendermode InteractiveServer
@inject EstudiantesServices EstudianteService

<EditForm Model="Estudiante" OnValidSubmit="Guardar">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <div class="card">
        <div class="card-header d-flex align-items-center" style="height: 58px;">
            <h5 class="mb-0">Registrar estudiante</h5>
        </div>
        <div class="card-body d-flex flex-column gap-2">
            <label class="form-label mb-0">
                Nombres
            </label>
            <InputText @bind-Value="Estudiante.Nombres" class="form-control"></InputText>
            <ValidationMessage For="@(() => Estudiante.Nombres)" />
            <label class="form-label mb-0">
                Dirección
            </label>
            <InputText @bind-Value="Estudiante.Direccion" class="form-control"></InputText>
            <ValidationMessage For="@(() => Estudiante.Direccion)" />
            <label class="form-label mb-0">
                Email
            </label>
            <InputText @bind-Value="Estudiante.Email" class="form-control"></InputText>
            <ValidationMessage For="@(() => Estudiante.Email)" />
            <label class="form-label mb-0">
                Fecha nacimiento
            </label>
            <InputDate @bind-Value="Estudiante.FechaNacimiento" class="form-control"></InputDate>
            <ValidationMessage For="@(() => Estudiante.FechaNacimiento)" />
        </div>
        <div class="d-flex p-3 pt-0 gap-3">
            <button class="btn btn-primary w-auto">
                <i class="bi bi-floppy2-fill"></i>
                Guardar
            </button>
            <a class="btn btn-warning w-auto" href="/Estudiantes/Index">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>
        </div>
    </div>
</EditForm>

@code {

    private Estudiantes Estudiante { get; set; } = new Estudiantes();
    private async Task Guardar()
    {
        if (await EstudianteService.Existe(Estudiante.Nombres))
        {
            return;
        }
        var estudianteGuardado = await EstudianteService.Guardar(Estudiante);
        if (estudianteGuardado)
        {
            Estudiante = new Estudiantes();
        }
        else
        {
            return;
        }
    }
}