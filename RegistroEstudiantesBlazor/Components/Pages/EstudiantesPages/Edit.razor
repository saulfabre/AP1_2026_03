@page "/Estudiantes/Edit/{EstudianteId:int}"
@rendermode InteractiveServer
@inject EstudiantesServices EstudianteService
@inject ToastService ToastService
@inject NavigationManager Navigation

@if (Estudiante != null)
{
    <EditForm Model="Estudiante" OnValidSubmit="Modificar">
        <DataAnnotationsValidator />
        <div class="card">
            <div class="card-header d-flex align-items-center" style="height: 58px;">
                <h5 class="mb-0">Modificar estudiante</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <label class="form-label mb-0">
                    Nombres
                </label>
                <InputText @bind-Value="Estudiante.Nombres" class="form-control"></InputText>
                <ValidationMessage For="@(() => Estudiante.Nombres)" />
                <label class="form-label mb-0">
                    Dirección
                </label>
                <InputText @bind-Value="Estudiante.Direccion" class="form-control"></InputText>
                <ValidationMessage For="@(() => Estudiante.Direccion)"></ValidationMessage>
                <label class="form-label mb-0">
                    Email
                </label>
                <InputText @bind-Value="Estudiante.Email" class="form-control"></InputText>
                <ValidationMessage For="@(() => Estudiante.Email)"></ValidationMessage>
                <label class="form-label mb-0">
                    Fecha nacimiento
                </label>
                <InputDate @bind-Value="Estudiante.FechaNacimiento" class="form-control"></InputDate>
                <ValidationMessage For="@(() => Estudiante.FechaNacimiento)"></ValidationMessage>
            </div>
            <div class="d-flex p-3 pt-0 gap-3">
                <button class="btn btn-primary w-auto" type="submit">
                    <i class="bi bi-pencil-square"></i>
                    Modificar
                </button>
                <a class="btn btn-warning w-auto" href="/Estudiantes/Index">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </EditForm>
}
else
{
    <p>Estudiante no encontrado</p>
}

@code {

    [Parameter]
    public int EstudianteId { get; set; }
    public Estudiantes? Estudiante { get; set; } = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        Estudiante = await EstudianteService.Buscar(EstudianteId);
    }
    private async Task Modificar()
    {
        if (Estudiante == null)
        {
            ToastService.ShowError("No se encontró el estudiante.","Error al buscar.");
            return;
        }
        var estudianteModificado = await EstudianteService.Modificar(Estudiante);
        if (estudianteModificado)
        {
            ToastService.ShowSuccess("Estudiante modificado correctamente.", "Estudiante modificado.");
            Navigation.NavigateTo("/Estudiantes/Index");
        }
        else
        {
            ToastService.ShowError("No se pudo modificar el estudiante.", "Error al modificar.");
            return;
        }
    }
}
