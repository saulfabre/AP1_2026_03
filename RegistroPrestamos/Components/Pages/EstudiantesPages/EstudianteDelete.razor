@page "/Estudiante/Delete/{EstudianteId:int}"
@using RegistroPrestamos.Extensors

@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject EstudiantesServices EstudianteService
@inject ToastService ToastService

<PageTitle>Eliminar Estudiante</PageTitle>

@if (Estudiante != null)
{
        @*Encabezado de la eliminación de estudiantes*@
        <div class="container">
            <div class="card shadow-lg">
                <div class="card-header d-flex align-items-center" style="height: 50px;">
                    <h5 class="mb-0">Eliminar Estudiante</h5>
                </div>

                @*Formulario*@
                <div class="card-body">
                    <div class="d-flex flex-column gap-2">

                        @*EstudianteId*@
                        <label class="form-label mb-0">
                            <strong>Id</strong>
                        </label>
                        <InputNumber class="form-control"  @bind-Value="Estudiante.EstudianteId" disabled></InputNumber>

                        @*Nombres*@
                        <label class="form-label mb-0">
                            <strong>Nombres</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Estudiante.Nombres" disabled></InputText>

                        @*Dirección*@
                        <label class="form-label mb-0">
                            <strong>Dirección</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Estudiante.Direccion" disabled></InputText> 

                        @*Email*@
                        <label class="form-label">
                            <strong>Email</strong>
                        </label>
                        <InputText class="form-control" @bind-Value="Estudiante.Email" disabled></InputText>

                        @*Fecha de Nacimiento*@
                        <label class="form-label">
                            <strong>Fecha de Nacimiento</strong>
                        </label>
                        <InputDate class="form-control" @bind-Value="Estudiante.FechaNacimiento" disabled></InputDate>
                    </div>
                </div>

                @*Botón Eliminar*@
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Eliminar
                    </button>

                    @*Botón Volver*@
                    <a href="/Estudiante/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @*Modal*@
        <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
            aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Confirmar eliminación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        ¿Desea la eliminación de este estudiante?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="Eliminar">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>
}
else
{
    <p>Estudiante no encontrado</p>
}

@code
{
    [Parameter]
    public int EstudianteId { get; set; } = new();

    public Estudiantes? Estudiante { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Estudiante = await EstudianteService.Buscar(EstudianteId);
    }

    private async Task Eliminar()
    {
        if (Estudiante == null)
        {
            ToastService.ShowWarning("Estudiante no encontrado", "Eliminar Estudiante");
            return;
        }

        if (await EstudianteService.Eliminar(EstudianteId))
        {   
            ToastService.ShowSuccess("Estudiante eliminado correctamente.", "Eliminar Estudiante");
            Navigation.NavigateTo("/Estudiante/Index");
            return;
        }
        else
        {   
            ToastService.ShowError("Error al eliminar estudiante.", "Eliminar Estudiante");
            return;
        }
    }
}
