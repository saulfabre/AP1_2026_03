@page "/Estudiante/Index"

@rendermode InteractiveServer

@inject EstudiantesServices EstudianteService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de estudiantes*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Estudiantes</h5>

            @*Bóton para crear un nuevo estudiante*@
            <a href="/Estudiante/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de estudiantes*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Direccion">Dirección</option>
                        <option value="Email">Email</option>
                        <option value="FechaNacimiento">Fecha Nacimiento</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                    <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                    @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de estudiantes*@
            <QuickGrid Items="@Estudiantes.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(e => e.EstudianteId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(e => e.Nombres)" Title="Nombres" Sortable="true" />
                <PropertyColumn Property="@(e => e.Direccion)" Title="Dirección" Sortable="true" />
                <PropertyColumn Property="@(e => e.Email)" Title="Email"Sortable="true" />
                <PropertyColumn Property="@(e => e.FechaNacimiento)" Title="Fecha Nacimiento" Format="yyyy-MM-dd" Sortable="true" />
                                

                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <a href="/Estudiante/Edit/@context.EstudianteId" class="btn btn-warning">Editar</a>
                    <a href="Estudiante/Delete/@context.EstudianteId" class="btn btn-danger">Eliminar</a>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Estudiantes.Count</p>
        </div>
    </div>
</div>

@code
{
    public List<Estudiantes> Estudiantes { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Estudiantes = await EstudianteService.GetList(e => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int estudianteId))
            {
                Estudiantes = await EstudianteService.GetList(e => e.EstudianteId == estudianteId);
            }
            else if (Filtro == "Nombres")
            {
                Estudiantes = await EstudianteService.GetList(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Direccion")
            {
                Estudiantes = await EstudianteService.GetList(e => e.Direccion.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Email")
            {
                Estudiantes = await EstudianteService.GetList(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "FechaNacimiento" && DateOnly.TryParse(ValorFiltro, out DateOnly fechaNacimiento))
            {
                Estudiantes = await EstudianteService.GetList(e => e.FechaNacimiento == fechaNacimiento);
            }
        }
        else
        {
            Estudiantes = await EstudianteService.GetList(e => true);
        }
    }
}
