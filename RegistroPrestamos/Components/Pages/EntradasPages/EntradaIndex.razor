@page "/Entrada/Index"

@rendermode InteractiveServer

@inject EntradasServices EntradaService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de entradas*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Entradas</h5>

            @*Bóton para crear una nueva entrada*@
            <a href="/Entrada/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de entradas*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Concepto">Concepto</option>
                        <option value="Fecha">Fecha</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de entradas*@
            <QuickGrid Items="@Entradas.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(e => e.EntradaId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(e => e.Fecha)" Title="Fecha" Format="yyyy-MM-dd" Sortable="true" />
                <PropertyColumn Property="@(e => e.Concepto)" Title="Concepto" Sortable="true" />
                <PropertyColumn Property="@(e => e.Total)" Title="Total" Sortable="true" />

                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="/Entrada/Edit/@context.EntradaId" class="btn btn-warning">Editar</a>
                        <a href="/Entrada/Delete/@context.EntradaId" class="btn btn-danger">Eliminar</a>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Entradas.Count</p>
        </div>
    </div>
</div>

@code
{
    public List<Entradas> Entradas { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Entradas = await EntradaService.GetList(e => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int entradaId))
            {
                Entradas = await EntradaService.GetList(e => e.EntradaId == entradaId);
            }
            else if (Filtro == "Concepto")
            {
                Entradas = await EntradaService.GetList(e => e.Concepto.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Fecha" && DateOnly.TryParse(ValorFiltro, out DateOnly fecha))
            {
                Entradas = await EntradaService.GetList(e => e.Fecha == fecha);
            }
        }
        else
        {
            Entradas = await EntradaService.GetList(e => true);
        }
    }
}
