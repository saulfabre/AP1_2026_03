@page "/Entrada/Delete/{EntradaId:int}"
@using RegistroPrestamos.Extensors

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject EntradasServices EntradaService
@inject ToastService ToastService

<PageTitle>Eliminar Entrada</PageTitle>

@if (Entrada != null)
{
    @*Encabezado de la eliminación de entradas*@
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header d-flex align-items-center" style="height: 50px;">
                <h5 class="mb-0">Eliminar Entrada</h5>
            </div>

            @*Formulario*@
            <div class="card-body">
                <div class="d-flex flex-column gap-2">

                    @*EntradaId*@
                    <label class="form-label mb-0"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Entrada.EntradaId" disabled></InputNumber>

                    @*Fecha*@
                    <label class="form-label mb-0"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Entrada.Fecha" disabled></InputDate>

                    @*Concepto*@
                    <label class="form-label mb-0"><strong>Concepto</strong></label>
                    <InputText class="form-control" @bind-Value="Entrada.Concepto" disabled></InputText>

                    @*Detalle de la entrada*@
                    <label class="form-label mt-2"><strong>Detalle de la entrada</strong></label>
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Libro</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (EntradasDetalle detalle in Entrada.Detalles)
                            {
                                <tr>
                                    <td>@detalle.Libro.Titulo</td>
                                    <td>@detalle.Cantidad</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <label class="form-label mb-0"><strong>Total</strong></label>
                    <InputNumber class="form-control" @bind-Value="Entrada.Total" disabled></InputNumber>
                </div>
            </div>

            @*Botón Eliminar*@
            <div class="card-footer d-flex gap-2">
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    Eliminar
                </button>

                @*Botón Volver*@
                <a href="/Entrada/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>

    @*Modal*@
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Desea eliminar esta entrada? La cantidad de libros será descontada del inventario.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>Entrada no encontrada</p>
}

@code
{
    [Parameter]
    public int EntradaId { get; set; } = new();

    public Entradas? Entrada { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Entrada = await EntradaService.Buscar(EntradaId);
    }

    private async Task Eliminar()
    {
        if (Entrada == null)
        {
            ToastService.ShowWarning("Entrada no encontrada", "Eliminar Entrada");
            return;
        }

        if (await EntradaService.Eliminar(EntradaId))
        {
            ToastService.ShowSuccess("Entrada eliminada correctamente.", "Eliminar Entrada");
            Navigation.NavigateTo("/Entrada/Index");
            return;
        }
        else
        {
            ToastService.ShowError("Error al eliminar entrada. Verifique que las cantidades del inventario sean suficientes.", "Eliminar Entrada");
            return;
        }
    }
}
