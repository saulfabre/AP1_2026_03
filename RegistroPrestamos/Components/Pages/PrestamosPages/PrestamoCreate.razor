@page "/Prestamo/Create"
@using RegistroPrestamos.Extensors

@rendermode InteractiveServer

@inject PrestamosServices PrestamoService
@inject ToastService ToastService

@inject EstudiantesServices EstudianteService

@inject LibrosServices LibroService

<PageTitle>Crear Prestamo</PageTitle>

<EditForm Model="Prestamo" OnValidSubmit="Guardar">

    <DataAnnotationsValidator/>

    @*Encabezado de la creación de prestamos*@
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header d-flex align-items-center" style="height: 50px;">
                <h5 class="mb-0">Crear Prestamo</h5>
            </div>

            @*Formulario para la creación de un prestamo*@
            <div class="card-body">
                <div class="d-flex flex-column gap-2">

                    @*Estudiante*@
                    <label class="form-label mb-0">
                        <strong>Estudiante</strong>
                    </label>
                    <InputSelect class="form-control" @bind-Value="Prestamo.EstudianteId">
                        <option value="0">Seleccione un estudiante</option>
                        @foreach (Estudiantes estudiante in Estudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Prestamo.EstudianteId)" />

                    @*Libro*@
                    <label class="form-label mb-0">
                        <strong>Libro</strong>
                    </label>
                    <InputSelect class="form-control" @bind-Value="Prestamo.LibroId">
                        <option value="0">Seleccione un libro</option>
                        @foreach (Libros libro in Libros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Prestamo.LibroId)"/>

                    @*Fecha Prestamo*@
                    <label class="form-label">
                        <strong>Fecha Prestamo</strong>
                    </label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                    <ValidationMessage For="@(() => Prestamo.FechaPrestamo)"/>

                    @*Fecha Devolucion*@
                    <label class="form-label">
                        <strong>Fecha Devolucion</strong>
                    </label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaDevolucion"></InputDate>
                    <ValidationMessage For="@(() => Prestamo.FechaDevolucion)"/>
                </div>
            </div>

            @*Botón Crear*@
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus"></i>
                    Crear
                </button>

            @*Botón Volver*@
                <a href="/Prestamo/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>
            </div>
        </div>
    </div>
</EditForm>

@code
{

    public Prestamos Prestamo { get; set; } = new();

    public List<Estudiantes> Estudiantes { get; set; } = new();

    public List<Libros> Libros { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        Estudiantes = await EstudianteService.GetList(e => true);

        Libros = await LibroService.GetList(l => true);
    }

    private async Task Guardar()
    {
        if (await PrestamoService.Existe(Prestamo.PrestamoId))
        {
            ToastService.ShowWarning("El préstamo ya existe en la base de datos.", "Préstamo duplicado");
            return;
        }
        var libro = Libros.FirstOrDefault(l => l.LibroId == Prestamo.LibroId);

        if (libro == null)
        {
            ToastService.ShowWarning("Libro no encontrado", "Crear Préstamo");
            return;
        }
        if (libro.Prestado)
        {
            ToastService.ShowWarning("El libro ya está prestado.", "Crear Préstamo");
            return;
        }
        if (await PrestamoService.Guardar(Prestamo))
        {
            libro.Prestado = true;
            await LibroService.Modificar(libro);
            ToastService.ShowSuccess("El préstamo ha sido creado exitosamente.", "Crear Préstamo");
            Prestamo = new Prestamos();
            return;
        }
        else
        {
            ToastService.ShowError("Error al crear préstamo.", "Crear Préstamo");
            return;
        }
    }
}
