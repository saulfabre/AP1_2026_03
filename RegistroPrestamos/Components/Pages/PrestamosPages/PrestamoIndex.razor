@page "/Prestamo/Index"

@rendermode InteractiveServer

@inject PrestamosServices PrestamoService

<PageTitle>Index</PageTitle>

@*Encabezado de la consulta de prestamos*@
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center" style="height: 50px;">
            <h5 class="mb-0">Consulta de Prestamos</h5>

            @*Bóton para crear un nuevo prestamo*@
            <a href="/Prestamo/Create" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                Crear
            </a>
        </div>

        @*Cuerpo de la consulta de prestamos*@
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                @*Filtrar por*@
                <div>
                    <label class="form-label"><strong>Filtrar por</strong></label>
                    <select class="form-select" @bind="Filtro">
                        <option value="Id">Id</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                        <option value="FechaPrestamo">Fecha Prestamo</option>
                        <option value="FechaDevolucion">Fecha Devolución</option>
                        <option value="Estado">Estado</option>
                    </select>
                </div>

                @*Búsqueda*@
                <div>
                    <label class="form-label"><strong>Búsqueda</strong></label>

                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" placeholder="Buscar..." @bind="ValorFiltro" />

                        @*Botón Buscar*@
                        <button class="btn btn-outline-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            @*Tabla para consultar información de prestamos*@
            <QuickGrid Items="@Prestamos.AsQueryable()" Class="table table-bordered mt-3 align-middle">
                <PropertyColumn Property="@(p => p.PrestamoId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(p => p.Estudiante.Nombres)" Title="Estudiante" Sortable="true" />
                <PropertyColumn Property="@(p => p.Libro.Titulo)" Title="Libro" Sortable="true" />
                <PropertyColumn Property="@(p => p.FechaPrestamo)" Title="Fecha Prestamo" Format="yyyy-MM-dd"
                                Sortable="true" />
                <PropertyColumn Property="@(p => p.FechaDevolucion)" Title="Fecha Devolución" Format="yyyy-MM-dd"
                                Sortable="true" />

                @*Estados*@
                <TemplateColumn Title="Estado">
                    @if (context.Devuelto)
                    {
                        <span class="badge bg-success">Devuelto</span>
                    }
                    else if (DateOnly.FromDateTime(DateTime.Today) > context.FechaDevolucion)
                    {
                        <span class="badge bg-danger">Retrasado</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Activo</span>
                    }
                </TemplateColumn>
                                
                @*Opciones*@
                <TemplateColumn Title="Opciones">
                    <div class="d-flex gap-2">
                        <a href="/Prestamo/Edit/@context.PrestamoId" class="btn btn-warning">Editar</a>
                        <div class="d-flex gap-2">
                            <a href="/Prestamo/Delete/@context.PrestamoId" class="btn btn-danger">Eliminar</a>
                        </div>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @*Footer*@
        <div class="card-footer">
            <p class="mb-0"><strong>Cantidad: </strong>@Prestamos.Count</p>
        </div>
    </div>
</div>

@code
{   

    public List<Prestamos> Prestamos { get; set; } = new();

    public string Filtro = "Id";
    public string ValorFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        Prestamos = await PrestamoService.GetList(p => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int prestamoId))
            {
                Prestamos = await PrestamoService.GetList(p => p.PrestamoId == prestamoId);
            }
            else if (Filtro == "Estudiante")
            {
                Prestamos = await PrestamoService.GetList(p => p.Estudiante.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Libro")
            {
                Prestamos = await PrestamoService.GetList(p => p.Libro.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "FechaPrestamo" && DateOnly.TryParse(ValorFiltro, out DateOnly fechaPrestamo))
            {
                Prestamos = await PrestamoService.GetList(p => p.FechaPrestamo == fechaPrestamo);
            }
            else if (Filtro == "FechaDevolucion" && DateOnly.TryParse(ValorFiltro, out DateOnly fechaDevolucion))
            {
                Prestamos = await PrestamoService.GetList(p => p.FechaDevolucion == fechaDevolucion);
            }
        }
        else
        {
            Prestamos = await PrestamoService.GetList(p => true);
        }
    }
}
