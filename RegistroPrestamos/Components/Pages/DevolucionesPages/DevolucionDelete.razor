@page "/Devolucion/Delete/{DevolucionId:int}"
@using RegistroPrestamos.Extensors

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject DevolucionesServices DevolucionService
@inject ToastService ToastService
@inject PrestamosServices PrestamoService
@inject LibrosServices LibroService

<PageTitle>Eliminar Devolucion</PageTitle>

@if (Devolucion != null && Prestamo != null)
{
    @*Encabezado de la eliminación de devoluciones*@
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header d-flex align-items-center" style="height: 50px;">
                <h5 class="mb-0">Eliminar Devolucion</h5>
            </div>

            @*Formulario*@
                    @*Formulario para la creación de una devolucion*@
                    <div class="card-body">
                        <div class="d-flex flex-column gap-2">

                            @*DevolucionId*@
                            <label class="form-label mb-0"><strong>Id</strong></label>
                            <InputNumber class="form-control" @bind-Value="Devolucion.DevolucionId" disabled></InputNumber>

                            @*Prestamo*@
                            <label class="form-label mb-0"><strong>Prestamo</strong></label>
                            <InputNumber class="form-control" @bind-Value="Devolucion.PrestamoId" disabled></InputNumber>

                            @*Estudiante*@
                            <label class="form-label mb-0"><strong>Estudiante</strong></label>
                            <InputText class="form-control" @bind-Value="Prestamo.Estudiante.Nombres" disabled></InputText>

                            @*Libro*@
                            <label class="form-label mb-0">
                                <strong>Libro</strong>
                            </label>
                            <InputText class="form-control" @bind-Value="Prestamo.Libro.Titulo" disabled></InputText>

                            @*Fecha Devolucion*@
                            <label class="form-label"><strong>Fecha Devolucion</strong></label>
                            <InputDate class="form-control" @bind-Value="Devolucion.FechaDevolucion" disabled></InputDate>
                        </div>
                    </div>

                    @*Botón Eliminar*@
                    <div class="card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal">
                            Eliminar
                        </button>

                        @*Botón Volver*@
                        <a href="/Devolucion/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i>
                            Volver
                        </a>
                    </div>
                </div>
            </div>
        @*Modal*@
        <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
             aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Confirmar eliminación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        ¿Desea la eliminación de esta devolucion?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="Eliminar">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>
}
else
{
    <p>Devolucion no encontrada</p>
}

@code
{
    [Parameter]
    public int DevolucionId { get; set; } = new();

    public Devoluciones? Devolucion { get; set; }
    public Prestamos? Prestamo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Devolucion = await DevolucionService.Buscar(DevolucionId);
        if (Devolucion != null)
        {
            Prestamo = await PrestamoService.Buscar(Devolucion.PrestamoId);
        }
    }

    private async Task Eliminar()
    {
        if (Devolucion == null || Prestamo == null)
        {
            ToastService.ShowWarning("Devolucion no encontrada", "Eliminar Devolucion");
            return;
        }

        if (await DevolucionService.Eliminar(DevolucionId))
        {
            Prestamo.Devuelto = false;
            await PrestamoService.Modificar(Prestamo);

            Prestamo.Libro.Prestado = true;
            await LibroService.Modificar(Prestamo.Libro);

            ToastService.ShowSuccess("Devolucion eliminada correctamente.", "Eliminar Devolucion");
            Navigation.NavigateTo("/Devolucion/Index");
            return;
        }
        else
        {
            ToastService.ShowError("Error al eliminar devolucion.", "Eliminar Devolucion");
            return;
        }
    }
}
