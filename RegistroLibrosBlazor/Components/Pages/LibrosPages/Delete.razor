@page "/Libros/Delete"
@page "/Libros/Delete/{LibroId:int}"
@using RegistroLibrosBlazor.Extensors

@inject LibrosService LibroService
@inject NavigationManager navigationManager
@inject ToastService ToastService

@if (Libro != null)
{

    <div class="card">
        <div class="card-header bg-white text-black">
            <h4 class="mb-0 fw-bold text-center"><i class="bi bi-book me-2"></i>Eliminar libro</h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">
                    Título
                </label>
                <InputText @bind-Value="Libro.Titulo" class="form-control" disabled></InputText>
                <div class="mb-3">
                    <label class="form-label">
                        Autor
                    </label>
                    <InputText @bind-Value="Libro.Autor" class="form-control" disabled></InputText>
                    <div class="mb-3">
                        <label class="form-label">
                            Año de publicación
                        </label>
                        <InputDate @bind-Value="Libro.AnoPublicacion" class="form-control" disabled></InputDate>
                    </div>
                    <button type="button" class="btn btn-danger" @onclick="EliminarLibro"><i
                        class="bi bi-x-circle-fill"></i>
                        Eliminar
                    </button>
                    <a href="Libros/Index" type="button" class="btn btn-light ms-2">
                        Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>Libro no encontrado</p>
}

@code {
    [Parameter]
    public int LibroId { get; set; }
    public Libros? Libro { get; set; } = new Libros();

    protected override async Task OnInitializedAsync()
    {
        Libro = await LibroService.Buscar(LibroId);
    }

    public async Task EliminarLibro()
    {
        if (await LibroService.Eliminar(LibroId))
        {
            Volver();
            ToastService.ShowSuccess("El libro se elimino correctamente", "Libro eliminado");
        }
    }

    public void Volver()
    {
        navigationManager.NavigateTo("/Libros/Index");
    }
}